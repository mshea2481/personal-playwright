{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pages/*":["./tests/pages/*"],
      "@lib/*":["./tests/lib/*"],
      "@components/*":["./tests/components/*"],
    }
  },
  "include": ["tests/**/*.ts", "playwright.config.ts"]
}