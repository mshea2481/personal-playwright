<!-- HERO IMAGE -->
    <div class="two soccer-page-two new-inquiry">
        <div class='soccer-page-header mx-auto text-left' style="max-width: 400px;">
        <h1 class="text-center">Inquiry Form</h1><br>
        <%= form_with model: @inquiry, local: true do |f| %>

            <div class="form-group">
                <%= f.label :name %>
                <%= f.text_field :name, class: "form-control", placeholder: "Your name", required: true, data: { testid: "inquiry-name-input" } %>
            </div>

            <div class="form-group">
                <%= f.label :email %>
                <%= f.email_field :email, class: "form-control", placeholder: "email@example.com", required: true, data: { testid: "inquiry-email-input" } %>
            </div>

            <div class="form-group">
                <%= f.label :phone %>
                <%= f.telephone_field :phone, class: "form-control", placeholder: "(###)###-####", required: true, data: { testid: "inquiry-phone-input" } %>
            </div>

            <div class="form-group">
                <%= f.label :message %>
                <%= f.text_area :message, class: "form-control", placeholder: "Your message here.", required: true, data: { testid: "inquiry-message-input" } %>
            </div>

            <%= f.submit "Send Inquiry", class: "btn btn-primary btn-block", data: { testid: "inquiry-submit-button" } %>

        <% end %>
        <div class='soccer-page-header-text'></div>
        </div>
    </div>

