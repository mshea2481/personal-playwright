    <div class="two soccer-page-two new-inquiry">
      <!-- <div class='soccer-page-header-background'> -->
        <div class='soccer-page-header mx-auto text-left' style="max-width: 400px;">
        <h1 class="text-center">Inquiry Form</h1><br>
        <%= form_with model: @inquiry, local: true do |f| %>

            <div class="form-group">
                <%= f.label :name %>
                <%= f.text_field :name, class: "form-control", required: true %>
            </div>

            <div class="form-group">
                <%= f.label :email %>
                <%= f.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="form-group">
                <%= f.label :phone %>
                <%= f.telephone_field :phone, class: "form-control", required: true %>
            </div>

            <div class="form-group">
                <%= f.label :message %>
                <%= f.text_area :message, class: "form-control", required: true %>
            </div>

            <%= f.submit "Send Inquiry", class: "btn btn-primary btn-block" %>

        <% end %>
        <div class='soccer-page-header-text'></div>
        </div>
      <!-- </div> -->
    </div>

