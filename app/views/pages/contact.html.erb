<div class="six">
  <div class="info-section">
    <h2 class="contact-form-heading" style="text-align:center;">Get In Touch</h2>

    <%= form_with url: contact_path, method: :post, local: true, html: { class: "contact-form" } do |f| %>
      <div class="form-group">
        <label for="name">Name</label>
        <%= f.text_field :name, class: "form-control", id: "name", placeholder: "Your name", required: true %>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <%= f.email_field :email, class: "form-control", id: "email", placeholder: "you@example.com", required: true %>
      </div>

      <div class="form-group">
        <label for="inquiry">Inquiry</label>
        <%= f.text_area :inquiry, class: "form-control", id: "inquiry", rows: 5, placeholder: "How can I help you?", required: true %>
      </div>

      <div class="form-group" style="text-align:center;">
        <%= f.submit "Send Message", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
