<div class="container" style="margin-top: 40px;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h1>Inquiries</h1>
    <%= button_to "Log Out", admin_logout_path, method: :delete, class: "btn btn-outline-secondary" %>
  </div>

  <% if @inquiries.any? %>
    <table class="table table-striped" style="margin-top: 20px;">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Message</th>
          <th>Received</th>
        </tr>
      </thead>
      <tbody>
        <% @inquiries.each do |inquiry| %>
          <tr>
            <td><%= inquiry.name %></td>
            <td><%= inquiry.email %></td>
            <td><%= inquiry.message %></td>
            <td><%= inquiry.created_at.strftime("%b %d, %Y %l:%M %p") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="margin-top: 20px;">No inquiries yet.</p>
  <% end %>
</div>
